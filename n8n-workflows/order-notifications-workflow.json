      "id": "webhook-msg91-callback",
      "name": "MSG91 Button Callback",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 1300],
      "webhookId": "msg91-callback"
    },
    {
      "parameters": {
        "jsCode": "// Parse the button payload from MSG91 callback\nconst payload = $input.first().json;\n\n// MSG91 sends button click data in different formats\n// Check for the button payload\nlet buttonPayload = payload.button?.payload || payload.interactive?.button_reply?.id || payload.payload || payload.text || '';\n\n// Parse action from payload: ACCEPT_orderId_itemId or REJECT_orderId_itemId\nconst parts = buttonPayload.split('_');\n\nif (parts.length >= 3) {\n  const action = parts[0]; // ACCEPT or REJECT\n  const orderId = parts[1];\n  const itemId = parts[2];\n  const merchantPhone = (payload.from || payload.sender || '').replace(/^91/, '');\n  \n  return {\n    json: {\n      action: action.toLowerCase(),\n      orderId: orderId,\n      itemId: itemId,\n      merchantPhone: merchantPhone,\n      originalPayload: payload\n    }\n  };\n}\n\n// If not a valid button click, return null action\nreturn {\n  json: {\n    action: null,\n    error: 'Invalid button payload',\n    originalPayload: payload\n  }\n};"
      },
      "id": "parse-button-payload",
      "name": "Parse Button Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 1300]
