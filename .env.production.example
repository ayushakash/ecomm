# Production Environment Variables

# Database
MONGODB_URI=mongodb://your-production-mongodb-uri

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-super-secret-session-key-change-this

# Server
PORT=5000
NODE_ENV=production

# Frontend URL
FRONTEND_URL=https://your-domain.com

# n8n Configuration
N8N_ENABLED=true
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/order-events
N8N_TIMEOUT=5000
N8N_RETRY_ATTEMPTS=3
N8N_RETRY_DELAY=1000

# MSG91 Configuration
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=CNSMAT
MSG91_ROUTE=4
MSG91_COUNTRY=91
MSG91_OTP_ENABLED=true
OTP_EXPIRY_MINUTES=5

# Abandoned Cart Configuration
ABANDONED_CART_ENABLED=true
CART_TRACKING_DELAY=15

# MinIO Storage Configuration
MINIO_ENDPOINT=storage.chardeevari.in
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=ecomm_minio_admin
MINIO_SECRET_KEY=MinioSecure5332173e9bbcdd
MINIO_PUBLIC_URL=https://storage.chardeevari.in
