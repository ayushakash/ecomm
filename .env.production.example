# Production Environment Variables
# Copy this to .env.production on your server and fill in actual values

# ================================
# ENVIRONMENT
# ================================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ================================
# DATABASE
# ================================
# Use MongoDB Atlas for production (recommended)
# Get from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/construction-ecommerce?retryWrites=true&w=majority

# ================================
# SECURITY (MUST CHANGE!)
# ================================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# ================================
# MSG91 CONFIGURATION
# ================================
MSG91_AUTH_KEY=471309TydHm2HpEe68dce0f9P1
MSG91_SENDER_ID=CNSMAT
MSG91_ROUTE=4
MSG91_COUNTRY=91

# SMS Configuration
MSG91_SMS_ENABLED=false
MSG91_SMS_OTP_TEMPLATE_ID=
MSG91_SMS_ORDER_TEMPLATE_ID=
MSG91_SMS_UPDATE_TEMPLATE_ID=
MSG91_SMS_CART_TEMPLATE_ID=
MSG91_SMS_WELCOME_TEMPLATE_ID=

# WhatsApp Configuration
MSG91_WHATSAPP_ENABLED=false
MSG91_WA_OTP_TEMPLATE_ID=
MSG91_WA_ORDER_TEMPLATE_ID=
MSG91_WA_UPDATE_TEMPLATE_ID=
MSG91_WA_CART_TEMPLATE_ID=
MSG91_WA_WELCOME_TEMPLATE_ID=

# ================================
# OTP CONFIGURATION
# ================================
MSG91_OTP_ENABLED=true
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RETRY_DELAY=30
MSG91_OTP_LOGIN_TEMPLATE=
MSG91_OTP_REGISTER_TEMPLATE=
MSG91_OTP_RESET_TEMPLATE=
MSG91_OTP_VERIFY_TEMPLATE=

# ================================
# FEATURES
# ================================
ABANDONED_CART_ENABLED=true
CART_TRACKING_DELAY=15

# n8n Configuration (Optional)
N8N_ENABLED=false
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/order-events
N8N_TIMEOUT=5000
N8N_RETRY_ATTEMPTS=3
N8N_RETRY_DELAY=1000

# ================================
# FRONTEND CONFIGURATION
# ================================
# Replace with your actual domain
FRONTEND_URL=https://uat.yourdomain.com
CLIENT_URL=https://uat.yourdomain.com
API_URL=https://uat.yourdomain.com/api

# ================================
# CORS CONFIGURATION
# ================================
ALLOWED_ORIGINS=https://uat.yourdomain.com,http://uat.yourdomain.com

# ================================
# OPTIONAL CONFIGURATIONS
# ================================

# Firebase (if using push notifications)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# AWS (if using S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Payment Gateway
