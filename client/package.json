{
  "name": "construction-ecommerce-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.4.0",
    "date-fns": "^2.30.0",
    "i18next": "^26.4.5",
    "jspdf": "^4.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.44.3",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^17.0.17",
    "react-icons": "^4.10.1",
    "react-leaflet": "^5.0.0",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.7.3",
    "recharts": "^3.1.2",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "react-snap": "^1.23.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "if [ \"$PRERENDER\" = \"false\" ]; then echo '⏭️  react-snap prerender skipped (PRERENDER=false)'; else react-snap; PAGES=$(find build -name index.html | wc -l); if [ \"$PAGES\" -ge 13 ] && grep -q 'rel=\"canonical\"' build/index.html && [ -z \"$(find build -name '*.html' -exec grep -l localhost:45678 {} +)\" ]; then echo \"✅ prerender verified: $PAGES pages, canonical present, no localhost leakage\"; else echo \"❌ prerender output INVALID — pages=$PAGES (need 13), or missing canonical, or localhost:45678 leaked. Set PRERENDER=false to skip intentionally.\"; exit 1; fi; fi",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "include": [
      "/",
      "/calculator",
      "/blog",
      "/blog/cement-calculation-1000-sqft-ranchi",
      "/blog/msand-vs-river-sand-jharkhand",
      "/blog/best-tmt-bars-ranchi-2026",
      "/contact",
      "/cement-price-ranchi",
      "/tmt-steel-price-ranchi",
      "/bricks-supplier-ranchi",
      "/sand-supplier-ranchi",
      "/construction-materials-ranchi",
      "/products"
    ],
    "crawl": false,
    "concurrency": 8,
    "skipThirdPartyRequests": true,
    "inlineCss": false,
    "puppeteerExecutablePath": "/usr/bin/chromium-browser",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000"
}
