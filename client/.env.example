# API Configuration
# For development, use localhost with port
# For production, use relative URL or full HTTPS URL
REACT_APP_API_URL=http://localhost:5000

# MSG91 Configuration
REACT_APP_MSG91_AUTH_KEY=your_msg91_auth_key_here
REACT_APP_MSG91_WIDGET_ID=your_msg91_widget_id_here

# Analytics & Tracking Configuration
# Google Analytics 4 (GA4) Measurement ID
# Get this from: https://analytics.google.com/
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID
# Get this from: https://business.facebook.com/events_manager2/
REACT_APP_META_PIXEL_ID=000000000000000

# Enable/Disable Analytics (set to 'false' in development if needed)
REACT_APP_ANALYTICS_ENABLED=true

# Google OAuth
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here
