# Database
# For Docker: use host.docker.internal to reach host's MongoDB
# For local development: use localhost
# MONGODB_URI=mongodb://host.docker.internal:27017/construction-ecommerce
 MONGODB_URI=mongodb://localhost:27017/construction-ecommerce

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Server
PORT=5000
NODE_ENV=development

# n8n Configuration
N8N_ENABLED=true
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/order-events
N8N_TIMEOUT=5000
N8N_RETRY_ATTEMPTS=3
N8N_RETRY_DELAY=1000

